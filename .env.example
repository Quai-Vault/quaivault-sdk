# ---------------------------------------------------------------------------
# QuaiVault SDK configuration
#
# Everything here is optional. With no environment at all the SDK targets mainnet
# over the public RPC in read-only mode, with indexer-backed features (discovery,
# history, realtime) already working — the presets ship indexer credentials.
#
# Precedence: explicit connect() options > these variables > network preset.
# ---------------------------------------------------------------------------

# Which built-in preset to use.
#   mainnet  chainId 9      https://rpc.quai.network
#   testnet  chainId 15000  https://orchard.rpc.quai.network   (Orchard)
QUAIVAULT_NETWORK=mainnet

# Quai RPC endpoint. Base URL only — the shard path is appended automatically.
# Defaults to the preset's endpoint; override for a private node.
# QUAIVAULT_RPC_URL=https://rpc.quai.network

# ---------------------------------------------------------------------------
# Signing
#
# Required only for writes (propose / approve / execute / deploy). Reads work
# without it. Keep this out of version control and out of shell history.
# ---------------------------------------------------------------------------
QUAIVAULT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Indexer (Supabase)
#
# All optional — the SDK ships working indexer credentials for both networks, so
# discovery, history and realtime work with no configuration at all.
#
# The publishable key is a public, read-only credential: the indexer's RLS grants
# the `anon` role SELECT and nothing else, with every write reserved for
# `service_role`. Override only to point at a self-hosted indexer, or if the key
# is rotated ahead of an SDK release.
#
# Schema must match the network: mainnet -> 'mainnet', Orchard testnet -> 'testnet'.
# ---------------------------------------------------------------------------
# QUAIVAULT_INDEXER_URL=https://xbftgyuxaxagptudledv.supabase.co
# QUAIVAULT_INDEXER_ANON_KEY=
# QUAIVAULT_INDEXER_SCHEMA=mainnet
# QUAIVAULT_INDEXER_HEALTH_URL=https://index.quaivault.org

# ---------------------------------------------------------------------------
# Contract overrides
#
# Only needed for a custom or unreleased deployment; the presets already carry
# the published mainnet and testnet addresses.
# ---------------------------------------------------------------------------
# QUAIVAULT_FACTORY=
# QUAIVAULT_IMPLEMENTATION=
# QUAIVAULT_SOCIAL_RECOVERY_MODULE=
# QUAIVAULT_MULTISEND_CALL_ONLY=

# ---------------------------------------------------------------------------
# Read behaviour
#
#   auto    (default) indexer while it is live and within the lag budget,
#           otherwise the chain
#   indexed indexer only — fastest, may be stale, fails if the indexer is down
#   chain   RPC only — authoritative, slower, no history queries
#
# Writes always re-validate against the chain regardless of this setting.
# ---------------------------------------------------------------------------
QUAIVAULT_CONSISTENCY=auto
QUAIVAULT_MAX_INDEXER_LAG_BLOCKS=50
